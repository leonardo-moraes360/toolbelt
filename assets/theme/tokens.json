{
  "$schema": "https://design-tokens.org/schema/tokens-0.1.0.json",
  "name": "Toolbelt Synthwave Theme",
  "version": "1.0.0",
  "description": "Tokens de design do tema Synthwave do toolbelt",
  "metadata": {
    "source": "assets/logo/toolbelt-logo.png",
    "extractedFrom": "Logo oficial do projeto"
  },
  "color": {
    "base": {
      "violeta": {
        "value": "#4A1999",
        "type": "color",
        "description": "Cor de fundo principal, extraída do círculo do logo"
      },
      "roxo": {
        "value": "#982BD4",
        "type": "color",
        "description": "Cor primária do cinto"
      },
      "roxo-sombra": {
        "value": "#761DC5",
        "type": "color",
        "description": "Sombra/variação escura do roxo"
      },
      "magenta": {
        "value": "#BE2AC6",
        "type": "color",
        "description": "Início do degradê da bolsinha"
      },
      "rosa": {
        "value": "#F9278C",
        "type": "color",
        "description": "Fim do degradê da bolsinha"
      },
      "ciano": {
        "value": "#0CD7FF",
        "type": "color",
        "description": "Cor do robô/destaque secundário"
      },
      "azul-escuro": {
        "value": "#00579A",
        "type": "color",
        "description": "Variação escura do ciano para contraste"
      },
      "quase-preto": {
        "value": "#29282D",
        "type": "color",
        "description": "Cor neutra escura, pontas do cinto"
      },
      "branco": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "Cor de texto/elementos claros"
      }
    },
    "semantic": {
      "background": {
        "value": "{color.base.violeta}",
        "type": "color",
        "description": "Fundo principal (modo escuro)"
      },
      "background-light": {
        "value": "#F5F3FA",
        "type": "color",
        "description": "Fundo principal (modo claro)"
      },
      "surface": {
        "value": "{color.base.quase-preto}",
        "type": "color",
        "description": "Superfícies elevadas (cards, modais)"
      },
      "surface-light": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "Superfícies (modo claro)"
      },
      "primary": {
        "value": "{color.base.roxo}",
        "type": "color",
        "description": "Cor primária de ação"
      },
      "primary-hover": {
        "value": "{color.base.roxo-sombra}",
        "type": "color",
        "description": "Primária em hover/focus"
      },
      "accent": {
        "value": "{color.base.ciano}",
        "type": "color",
        "description": "Cor de destaque/accent"
      },
      "accent-dark": {
        "value": "{color.base.azul-escuro}",
        "type": "color",
        "description": "Accent escuro para contraste"
      },
      "text": {
        "value": "{color.base.branco}",
        "type": "color",
        "description": "Texto principal (modo escuro)"
      },
      "text-light": {
        "value": "{color.base.quase-preto}",
        "type": "color",
        "description": "Texto principal (modo claro)"
      },
      "text-muted": {
        "value": "#A099B0",
        "type": "color",
        "description": "Texto secundário/muted"
      },
      "error": {
        "value": "{color.base.rosa}",
        "type": "color",
        "description": "Erros e alertas críticos"
      },
      "success": {
        "value": "#2DD4A7",
        "type": "color",
        "description": "Sucesso e confirmações"
      },
      "warning": {
        "value": "#FFB020",
        "type": "color",
        "description": "Avisos e atenção"
      }
    },
    "gradient": {
      "primary": {
        "value": "linear-gradient(180deg, #BE2AC6 0%, #F9278C 100%)",
        "type": "gradient",
        "description": "Degradê primário magenta→rosa (vertical)"
      },
      "belt": {
        "value": "linear-gradient(90deg, #29282D 0%, #761DC5 15%, #982BD4 50%, #761DC5 85%, #29282D 100%)",
        "type": "gradient",
        "description": "Degradê do cinto (horizontal)"
      },
      "accent": {
        "value": "linear-gradient(135deg, #0CD7FF 0%, #00579A 100%)",
        "type": "gradient",
        "description": "Degradê accent ciano→azul"
      }
    }
  },
