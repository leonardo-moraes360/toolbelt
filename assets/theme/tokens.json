        "description": "Rosa para erros"
      },
      "success": {
        "ansi256": 43,
        "truecolor": "#2DD4A7",
        "description": "Verde para sucesso"
      },
      "warning": {
        "ansi256": 214,
        "truecolor": "#FFB020",
        "description": "Amarelo para avisos"
      },
      "text": {
        "ansi256": 15,
        "truecolor": "#FFFFFF",
        "description": "Texto branco"
      },
      "muted": {
        "ansi256": 249,
        "truecolor": "#A099B0",
        "description": "Texto muted"
      }
    }
  },
